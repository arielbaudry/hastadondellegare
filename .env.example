# Copiar a .env.local (desarrollo) o cargar como variables de entorno en Vercel.

# ---------------------------------------------------------------- contenido
# Fecha en que se cierra el modo abierto. Se muestra en el cartel de arriba.
# Si se deja vacío, el cartel dice "por unos días" sin fecha.
NEXT_PUBLIC_MODO_ABIERTO_HASTA=2026-09-15

# ------------------------------------------------------------ persistencia
# Sin estas dos variables el árbol se guarda en storage/tree.json (disco).
# Eso sirve en local, pero NO en Vercel: el disco de la función es efímero y
# se pierde en cada deploy. En Vercel hay que conectar un Upstash Redis
# (Marketplace → Upstash → Redis) y dejar que inyecte estas variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave del documento dentro de Redis. Cambiala si querés dos árboles distintos
# (por ejemplo, uno de prueba y otro real) sobre la misma base.
ARBOL_KEY=hastadondellegare:arbol

# ----------------------------------------------------- acceso por magic link
# El candado se enciende SOLO si están SESION_SECRETO y las tres de SMTP. Sin
# eso el sitio queda abierto como estaba: es a propósito, para que un deploy a
# medio configurar no deje a nadie afuera.
#
# Secreto para firmar enlaces y sesiones. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESION_SECRETO=

# El único administrador (puede eliminar). El resto entra como colaborador.
# Se configura en Vercel, no acá: el repositorio es público.
ADMIN_EMAIL=

# SMTP de DAS Latam (Ferozo). El puerto 465 va con SSL directo; 587 con STARTTLS.
SMTP_HOST=va000847.ferozo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_DESDE=

# Se muestran en la pantalla de acceso a quien todavía no tiene ficha.
# Van vacías acá a propósito: este archivo es público y son datos personales.
CONTACTO_EMAIL=
CONTACTO_TELEFONO=

# URL pública, para armar los enlaces del correo. En Vercel se deduce sola.
SITIO_URL=https://hastadondellegare.vercel.app

# --------------------------------------------------------------- borrar cosas
# Sin esta clave, eliminar personas / importar respaldos / sembrar el ejemplo
# están BLOQUEADOS para todos: es el default seguro mientras el árbol es
# público. Poniéndola, se habilitan desde Ajustes escribiéndola una vez por
# navegador. Elegí algo largo; no la compartas con la familia.
ADMIN_CLAVE=

# ------------------------------------------------------------------- fotos
# Con esta variable las fotos van a Vercel Blob; sin ella, a storage/uploads/.
# La inyecta sola Vercel al conectar un Blob store al proyecto.
BLOB_READ_WRITE_TOKEN=
